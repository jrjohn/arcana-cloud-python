# ============================================================================
# Arcana Cloud - Base Docker Image
# ============================================================================
# This is the base image for all deployment modes
# Contains Python runtime and common dependencies
# ============================================================================

ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim-bullseye AS base

# Build arguments
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0

# Metadata labels
LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.authors="Arcana Cloud Team" \
      org.opencontainers.image.url="https://arcana-cloud.com" \
      org.opencontainers.image.source="https://github.com/arcana-cloud/arcana-cloud-python" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.title="Arcana Cloud Base Image" \
      org.opencontainers.image.description="Base Docker image for Arcana Cloud Python application"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive \
    APP_HOME=/app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build essentials
    gcc \
    g++ \
    make \
    # Database clients
    default-libmysqlclient-dev \
    pkg-config \
    # Network tools
    curl \
    wget \
    netcat \
    # Security
    ca-certificates \
    # Cleanup
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/* /var/tmp/*

# Create application directory
WORKDIR ${APP_HOME}

# Create non-root user for security
RUN groupadd -r appuser && \
    useradd -r -g appuser -u 1000 -m -d /home/appuser appuser && \
    chown -R appuser:appuser ${APP_HOME}

# Copy requirements file
COPY requirements.txt requirements-dev.txt ./

# Install Python dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt
    # Install dev dependencies for testing (optional)
    # pip install -r requirements-dev.txt

# Copy application code
COPY --chown=appuser:appuser . .

# Create necessary directories
RUN mkdir -p \
    /app/logs \
    /app/uploads \
    /app/migrations \
    && chown -R appuser:appuser /app

# Health check script
COPY --chown=appuser:appuser docker/healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/healthcheck.sh

# Switch to non-root user
USER appuser

# Default port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh

# Default command (should be overridden in derived images)
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "4", "--threads", "2", "--timeout", "60", "wsgi:application"]
