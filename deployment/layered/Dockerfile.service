# ============================================================================
# Arcana Cloud - Service Layer
# ============================================================================
# Contains business logic and service implementations
# Communicates with Repository layer for data access
# ============================================================================

FROM arcanacloud/arcana-cloud-base:latest AS service

# Set deployment layer
ENV DEPLOYMENT_LAYER=service \
    SERVICE_NAME=arcana-cloud-service \
    SERVICE_PORT=5001

# Service-specific environment variables
ENV USER_REPO_URLS=http://repository-layer:5002 \
    GRPC_PORT=50051

# Expose service ports (HTTP and gRPC)
EXPOSE 5001 50051

# Switch back to root to install entrypoint and health check
USER root
COPY docker/entrypoint-service.sh /usr/local/bin/entrypoint.sh
COPY docker/healthcheck-service.sh /usr/local/bin/healthcheck-service.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh && \
    chmod 755 /usr/local/bin/healthcheck-service.sh
USER appuser

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Start Gunicorn with optimized settings for business logic processing
CMD ["gunicorn", \
     "--bind", "0.0.0.0:5001", \
     "--workers", "4", \
     "--threads", "2", \
     "--worker-class", "sync", \
     "--worker-tmp-dir", "/dev/shm", \
     "--timeout", "60", \
     "--graceful-timeout", "30", \
     "--keep-alive", "5", \
     "--max-requests", "500", \
     "--max-requests-jitter", "50", \
     "--log-level", "info", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--statsd-host", "localhost:8125", \
     "wsgi:app"]

# Health check specific to service layer (protocol-aware)
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=3 \
    CMD /usr/local/bin/healthcheck-service.sh
