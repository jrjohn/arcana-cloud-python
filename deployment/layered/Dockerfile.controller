# ============================================================================
# Arcana Cloud - Controller Layer
# ============================================================================
# Contains only API controllers and routing logic
# Communicates with Service layer for business logic
# ============================================================================

FROM arcanacloud/arcana-cloud-base:1.0.0 AS controller

# Set deployment layer
ENV DEPLOYMENT_LAYER=controller \
    SERVICE_NAME=arcana-cloud-controller \
    SERVICE_PORT=5000

# Controller-specific environment variables
ENV USER_SERVICE_URLS=http://service-layer:5001 \
    AUTH_SERVICE_URLS=http://service-layer:5001

# Expose API port
EXPOSE 5000

# Copy controller-specific entrypoint
COPY docker/entrypoint-controller.sh /usr/local/bin/entrypoint.sh

# Start Gunicorn with optimized settings for API gateway
CMD ["gunicorn", \
     "--bind", "0.0.0.0:5000", \
     "--workers", "4", \
     "--threads", "4", \
     "--worker-class", "sync", \
     "--worker-tmp-dir", "/dev/shm", \
     "--timeout", "30", \
     "--graceful-timeout", "15", \
     "--keep-alive", "5", \
     "--max-requests", "1000", \
     "--max-requests-jitter", "100", \
     "--log-level", "info", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--statsd-host", "localhost:8125", \
     "wsgi:app"]

# Health check specific to controller
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1
